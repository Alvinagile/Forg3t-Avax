# ForgEvidenceAnchor — Deployment Environment
# Copy this file to .env and fill in the values. Never commit .env.

# ── Deployer ──────────────────────────────────────────────────────────────────
# Private key of the wallet paying for deployment gas (without 0x prefix)
DEPLOYER_PRIVATE_KEY=

# ── Ownership ─────────────────────────────────────────────────────────────────
# Address that will own the contract (can transfer/renounce ownership)
OWNER_ADDRESS=

# ── Verification ──────────────────────────────────────────────────────────────
# Snowtrace API key for contract source verification
# Get one at: https://snowtrace.io/myapikey
SNOWTRACE_API_KEY=
